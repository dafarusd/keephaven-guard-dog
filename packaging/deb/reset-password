#!/bin/sh
# "Reset Guard Dog password" (apps menu), run by pkexec after the admin password: asks the service to clear the
# dashboard password on its next start, then restarts it. People, findings and everything else stay.
# Takes no arguments and trusts nothing from the environment.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
DATA=/var/lib/keephaven-guard-dog
[ -d "$DATA" ] || { echo "Guard Dog has no data folder yet: nothing to reset."; exit 1; }
: > "$DATA/reset-password"
chown keephaven-guard-dog:keephaven-guard-dog "$DATA/reset-password"
chmod 600 "$DATA/reset-password"
systemctl restart keephaven-guard-dog.service
echo "Done. Open Keephaven Guard Dog and set a new password (within 30 minutes)."
