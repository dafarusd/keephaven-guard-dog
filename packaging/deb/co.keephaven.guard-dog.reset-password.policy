<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Keephaven</vendor>
  <vendor_url>https://keephaven.co</vendor_url>
  <action id="co.keephaven.guard-dog.reset-password">
    <description>Reset the Guard Dog password</description>
    <message>Reset the Guard Dog password. Your people and findings stay.</message>
    <icon_name>dialog-password</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/keephaven-guard-dog/bin/reset-password</annotate>
  </action>
</policyconfig>
