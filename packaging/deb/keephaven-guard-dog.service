[Unit]
Description=Keephaven Guard Dog
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=keephaven-guard-dog
Group=keephaven-guard-dog
StateDirectory=keephaven-guard-dog
StateDirectoryMode=0700
Environment=HOME=/var/lib/keephaven-guard-dog
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/keephaven-guard-dog/browsers
ExecStart=/opt/keephaven-guard-dog/venv/bin/keephaven-guard-dog --data /var/lib/keephaven-guard-dog --host 127.0.0.1 --port 8642 --require-password --network-switch
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
